# Server-only Google Sheets lookup configuration. Do not expose these through
# NEXT_PUBLIC_* variables or client components.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_FORM_RESPONSES_RANGE="'การตอบแบบฟอร์ม 1'!A:U"
GOOGLE_SHEETS_MANUAL_SPREADSHEET_ID=
GOOGLE_SHEETS_MANUAL_RANGE=
GOOGLE_SHEETS_WEB_ORDERS_SPREADSHEET_ID=
GOOGLE_SHEETS_WEB_ORDERS_RANGE=Orders!A:Q
GOOGLE_SHEETS_WEB_ORDER_ITEMS_RANGE=OrderItems!A:H
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional short-lived cache for raw Sheet reads. Defaults to 60 seconds.
GOOGLE_SHEETS_CACHE_TTL_SECONDS=60
